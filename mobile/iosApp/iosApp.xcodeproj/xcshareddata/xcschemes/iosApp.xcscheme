   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Workaround SPM Custom Configuration Bundle Bug"
               scriptText = "BASE_CONFIG=$(echo &quot;$CONFIGURATION&quot; | cut -d&apos;-&apos; -f1)&#10;if [ &quot;$BASE_CONFIG&quot; != &quot;$CONFIGURATION&quot; ]; then&#10;  SPM_BUILD_DIR=&quot;$SYMROOT/${BASE_CONFIG}${EFFECTIVE_PLATFORM_NAME}&quot;&#10;  mkdir -p &quot;$BUILT_PRODUCTS_DIR&quot;&#10;  BUNDLES=(&quot;AppAuth_AppAuth.bundle&quot; &quot;AppAuth_AppAuthCore.bundle&quot; &quot;GoogleSignIn_GoogleSignIn.bundle&quot; &quot;GTMSessionFetcher_GTMSessionFetcherCore.bundle&quot;)&#10;  for bundle in &quot;${BUNDLES[@]}&quot;; do&#10;    ln -sf &quot;$SPM_BUILD_DIR/$bundle&quot; &quot;$BUILT_PRODUCTS_DIR/$bundle&quot;&#10;  done&#10;fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "78B53CC79860CBFC2F5543C6"
                     BuildableName = "SegurancaRuralDEV.app"
                     BlueprintName = "iosApp"
                     ReferencedContainer = "container:iosApp.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
